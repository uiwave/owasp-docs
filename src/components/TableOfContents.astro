---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filtrar solo encabezados H2 y H3
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length === 0 ? (
    <p class="font-hand text-text-muted text-base italic">Sin secciones definidas</p>
  ) : (
    <nav class="space-y-1.5">
      <p class="font-hand text-text-muted mb-3 text-sm font-bold tracking-widest uppercase">
        Table of Contents
      </p>
      {filteredHeadings.map((heading) => {
        const isH3 = heading.depth === 3;
        return (
          <a
            href={`#${heading.slug}`}
            class:list={[
              "text-text-muted hover:text-accent-red block leading-snug transition-colors duration-150",
              isH3
                ? "pl-6 text-xs md:text-sm"
                : "text-text-main pl-0 text-sm font-semibold md:text-base",
            ]}
          >
            <span class="block truncate">{heading.text}</span>
          </a>
        );
      })}
    </nav>
  )
}
