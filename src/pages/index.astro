---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Bienvenido a la Documentación">
  <main class="flex-1 flex flex-col items-center justify-center p-6 text-center max-w-4xl mx-auto">
    <div class="bg-bg-surface border-2 border-border-grid p-8 sm:p-12 rounded-2xl shadow-lg relative transform -rotate-1">
      <span class="font-script text-3xl text-accent-red block mb-2">¡Hola, desarrollador!</span>
      <h1 class="font-hand font-bold text-4xl sm:text-6xl text-text-main mb-6 leading-tight">
        Documentación del Proyecto
      </h1>
      <p class="font-write text-xl sm:text-2xl text-text-muted mb-8 max-w-xl mx-auto">
        Aprende cómo funciona el sistema paso a paso con guías explicadas en detalle.
      </p>
      
      <a 
        href="/docs/owas-top/inicio" 
        class="inline-block font-hand font-bold text-2xl bg-accent-yellow hover:bg-accent-teal hover:text-white text-text-main px-8 py-3 rounded-xl border-2 border-border-grid shadow-md hover:scale-105 transition-all"
      >
        🚀 Empezar a Leer
      </a>
    </div>
  </main>
</MainLayout>