---
import { getCollection } from "astro:content";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

const allDocs = await getCollection("docs");

function cleanSegment(segment: string) {
  return segment.replace(/^\d+-/, "");
}

interface GroupedDoc {
  cleanSlug: string;
  title: string;
  folderClean: string;
}

const groups: Record<string, GroupedDoc[]> = {};

allDocs.forEach((doc) => {
  const identifier = doc.id || "";
  const parts = identifier.replace(/\.mdx?$/, "").split("/");

  if (parts.length > 1) {
    const rawFolder = parts[0];
    const folderClean = cleanSegment(rawFolder);
    const cleanSlug = parts.map(cleanSegment).join("/");

    if (!groups[folderClean]) {
      groups[folderClean] = [];
    }

    groups[folderClean].push({
      cleanSlug,
      title: doc.data.title,
      folderClean,
    });
  }
});
---

<nav class="flex flex-col gap-y-8">
  {
    Object.entries(groups).map(([folderName, items]) => {
      const hasActiveChild = items.some(
        (item) => item.cleanSlug === currentSlug,
      );
      return (
        <details class="group" open={hasActiveChild}>
          <summary class="text-ink hover:text-ink/80 font-hand flex cursor-pointer list-none items-center justify-between px-1 py-1 text-lg font-bold tracking-wider uppercase transition-colors select-none">
            <span>{folderName}</span>
            <span class="text-xs opacity-60 transition-transform duration-200 group-open:rotate-180">
              ▼
            </span>
          </summary>

          <ul class="space-y-1.5 pl-5 pt-1">
            {items.map((item) => {
              const isActive = currentSlug === item.cleanSlug;
              return (
                <li>
                  <a
                    href={`/${item.cleanSlug}`}
                    class={`block py-1 text-sm leading-snug transition-colors duration-150 md:text-base ${
                      isActive
                        ? "text-ink font-bold underline decoration-2 underline-offset-4"
                        : "text-ink2 hover:text-ink"
                    }`}
                  >
                    <span class="block">{item.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })
  }
</nav>