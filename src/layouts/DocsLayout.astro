---
import MainLayout from "./MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  currentSlug: string;
  headings: MarkdownHeading[];
}

const { title, currentSlug, headings } = Astro.props;
---

<MainLayout title={title}>
  <div class="px-6 grid grid-cols-1 lg:grid-cols-[300px_1fr_300px] gap-10 items-start">
    
    <!-- Columna 1: Menú Lateral Izquierdo -->
    <nav class="lg:sticky lg:top-[90px] h-[calc(100vh-100px)] overflow-y-auto text-[14.5px] pr-2 custom-scrollbar">
      <Sidebar currentSlug={currentSlug} />
    </nav>

    <!-- Columna 2: Contenido Principal (Markdown) -->
    <main class="min-w-0 pb-12">
      <slot />
    </main>

    <!-- Columna 3: Índice Ancla Derecho (TOC) -->
    <aside class="lg:sticky lg:top-[90px] h-[calc(100vh-100px)] overflow-y-auto text-[13.5px] pl-2 custom-scrollbar">
      <TableOfContents headings={headings} />
    </aside>

  </div>
</MainLayout>