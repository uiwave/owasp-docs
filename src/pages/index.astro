---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Bienvenido a la Documentación">
  <main
    class="mx-auto flex max-w-4xl flex-1 flex-col items-center justify-center p-6 text-center"
  >
    <div
      class="bg-bg-surface border-border-grid shadow-soft relative -rotate-1 transform rounded-2xl border-2 p-8 sm:p-12"
    >
      <span class="font-script text-accent-red mb-2 block text-3xl"
        >¡Hola, desarrollador!</span
      >
      <h1
        class="font-hand text-text-main mb-6 text-4xl leading-tight font-bold tracking-wide sm:text-6xl"
      >
        Documentación del Proyecto
      </h1>
      <p
        class="font-write text-text-muted mx-auto mb-8 max-w-xl text-xl sm:text-2xl"
      >
        Aprende cómo funciona el sistema paso a paso con guías explicadas en
        detalle.
      </p>

      <a
        href="/inicio"
        class="font-hand bg-accent-yellow hover:bg-accent-teal text-text-main border-border-grid shadow-soft hover:shadow-lift inline-block rounded-xl border-2 px-8 py-3 text-2xl font-bold transition-all hover:scale-105 hover:text-bg-main"
      >
        🚀 Empezar a Leer
      </a>
    </div>
  </main>
</MainLayout>
